# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Mercado Pago (Production access token! APP_USR-...)
# Nunca prefije essas variaveis com NEXT_PUBLIC_
# ---------------------------------------------------------------------------
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# API de licencas Proex (somente backend, por HTTPS)
# ---------------------------------------------------------------------------
LICENSE_API_BASE=https://api.gravonyx.com
LICENSE_API_SECRET=

# ---------------------------------------------------------------------------
# E-mail da chave (SMTP do Zoho Mail)
# SMTP_PASS é uma SENHA DE APP gerada no Zoho (Menu do usuário -> Segurança ->
# Senhas de app), nunca a senha da conta. MAIL_FROM precisa ser a própria caixa
# autenticada ou um alias verificado dela, senão o Zoho recusa o envio.
# Contas .eu usam smtp.zoho.eu.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Opcional
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
